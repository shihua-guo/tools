# Telegram Bot API Token (Get it from @BotFather)
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Allowed Telegram User IDs (Comma separated integers)
# Example: ALLOWED_USER_IDS="123456789,987654321"
# Get your ID from @userinfobot
ALLOWED_USER_IDS="your_telegram_user_id_here"

# CLI Binaries Path (if they are not in PATH, specify absolute path)
CLAUDE_BIN="claude"
CODEX_BIN="codex"

# Bot Working Directory (Where the commands will be executed)
# e.g., /home/user/workspace
WORK_DIR="."
