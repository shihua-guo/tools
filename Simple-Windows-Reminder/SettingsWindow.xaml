<Window x:Class="Simple_Windows_Reminder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Windows Reminder 设置"
        Width="460"
        Height="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="TaskInput"
                     MinHeight="34"
                     VerticalContentAlignment="Center"
                     Margin="0,0,8,0"
                     DockPanel.Dock="Left"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     KeyDown="TaskInput_OnKeyDown" />
            <Button Content="添加"
                    Width="78"
                    Click="AddButton_OnClick" />
        </DockPanel>

        <ListBox x:Name="TaskList"
                 Grid.Row="1"
                 ItemsSource="{Binding DisplayItems}"
                 SelectionMode="Single">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}"
                               TextWrapping="Wrap"
                               Padding="2" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2"
                Content="删除选中任务"
                Height="32"
                Margin="0,10,0,14"
                Click="DeleteButton_OnClick" />

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="文字颜色" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" SelectedValue="{Binding State.TextColor, Mode=TwoWay}" SelectedValuePath="Tag">
                <ComboBoxItem Content="白色" Tag="#FFFFFFFF" />
                <ComboBoxItem Content="黑色" Tag="#FF000000" />
                <ComboBoxItem Content="红色" Tag="#FFFF4D4F" />
                <ComboBoxItem Content="黄色" Tag="#FFFFD666" />
                <ComboBoxItem Content="绿色" Tag="#FF73D13D" />
            </ComboBox>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="透明度" Margin="0,10,0,0" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0.2" Maximum="1" TickFrequency="0.05" Value="{Binding State.Opacity, Mode=TwoWay}" Margin="0,10,0,0" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="字号" Margin="0,10,0,0" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="14" Maximum="48" TickFrequency="1" Value="{Binding State.FontSize, Mode=TwoWay}" Margin="0,10,0,0" />

            <CheckBox Grid.Row="3"
                      Grid.ColumnSpan="2"
                      Content="鼠标穿透"
                      IsChecked="{Binding State.ClickThrough, Mode=TwoWay}"
                      Margin="0,12,0,0" />

            <CheckBox Grid.Row="4"
                      Grid.ColumnSpan="2"
                      Content="开机自启动"
                      IsChecked="{Binding State.StartWithWindows, Mode=TwoWay}"
                      Margin="0,8,0,0" />
        </Grid>
    </Grid>
</Window>
