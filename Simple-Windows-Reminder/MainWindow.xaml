<Window x:Class="Simple_Windows_Reminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple Windows Reminder"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Border x:Name="RootBorder"
            Padding="14"
            Background="#01000000"
            CornerRadius="4">
        <ItemsControl ItemsSource="{Binding DisplayItems}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}"
                               FontFamily="Microsoft YaHei UI"
                               FontWeight="SemiBold"
                               FontSize="{Binding DataContext.State.FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{Binding DataContext.State.TextBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5"
                                              ShadowDepth="1"
                                              Opacity="0.75"
                                              Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
